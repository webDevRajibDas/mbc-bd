  KEY `welfare_contributions_welfare_id_foreign` (`welfare_id`),
  CONSTRAINT `welfare_contributions_employee_id_foreign` FOREIGN KEY (`employee_id`) REFERENCES `employees` (`id`) ON DELETE CASCADE,
  CONSTRAINT `welfare_contributions_welfare_id_foreign` FOREIGN KEY (`welfare_id`) REFERENCES `welfares` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
